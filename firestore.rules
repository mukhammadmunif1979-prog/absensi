rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Zero-Trust Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---
    function isValidAttendanceRecord(data, userId) {
      return data.keys().hasAll([
               'userId',
               'employeeId',
               'employeeName',
               'status',
               'latitude',
               'longitude',
               'accuracyMeters',
               'distanceMeters',
               'withinRadius',
               'mapsUrl',
               'capturedTimeText',
               'photoBase64',
               'syncedToSheets',
               'createdAt',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId',
               'employeeId',
               'employeeName',
               'status',
               'latitude',
               'longitude',
               'accuracyMeters',
               'distanceMeters',
               'withinRadius',
               'mapsUrl',
               'capturedTimeText',
               'photoBase64',
               'syncedToSheets',
               'createdAt',
               'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId &&
             data.employeeId is string && data.employeeId.size() >= 1 && data.employeeId.size() <= 50 &&
             data.employeeName is string && data.employeeName.size() >= 1 && data.employeeName.size() <= 100 &&
             data.status is string && data.status in ['CHECK_IN', 'CHECK_OUT'] &&
             data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
             data.longitude is number && data.longitude >= -180 && data.longitude <= 180 &&
             data.accuracyMeters is number && data.accuracyMeters >= 0 && data.accuracyMeters <= 100000 &&
             data.distanceMeters is number && data.distanceMeters >= 0 && data.distanceMeters <= 20050000 &&
             data.withinRadius is bool &&
             data.mapsUrl is string && data.mapsUrl.size() >= 1 && data.mapsUrl.size() <= 200 &&
             data.capturedTimeText is string && data.capturedTimeText.size() >= 1 && data.capturedTimeText.size() <= 64 &&
             data.photoBase64 is string && data.photoBase64.size() >= 1 && data.photoBase64.size() <= 400000 &&
             data.syncedToSheets is bool &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidWorkplaceSettings(data, userId) {
      return data.keys().hasAll([
               'userId',
               'defaultEmployeeId',
               'defaultEmployeeName',
               'officeName',
               'officeLatitude',
               'officeLongitude',
               'maxRadiusMeters',
               'geofenceEnabled',
               'sheetsWebhookUrl',
               'createdAt',
               'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId',
               'defaultEmployeeId',
               'defaultEmployeeName',
               'officeName',
               'officeLatitude',
               'officeLongitude',
               'maxRadiusMeters',
               'geofenceEnabled',
               'sheetsWebhookUrl',
               'createdAt',
               'updatedAt'
             ]) &&
             data.userId is string && data.userId == userId &&
             data.defaultEmployeeId is string && data.defaultEmployeeId.size() <= 50 &&
             data.defaultEmployeeName is string && data.defaultEmployeeName.size() <= 100 &&
             data.officeName is string && data.officeName.size() <= 100 &&
             data.officeLatitude is number && data.officeLatitude >= -90 && data.officeLatitude <= 90 &&
             data.officeLongitude is number && data.officeLongitude >= -180 && data.officeLongitude <= 180 &&
             data.maxRadiusMeters is number && data.maxRadiusMeters >= 10 && data.maxRadiusMeters <= 50000 &&
             data.geofenceEnabled is bool &&
             data.sheetsWebhookUrl is string && data.sheetsWebhookUrl.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- User-Scoped Attendance Records ---
    match /users/{userId}/attendance/{recordId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(recordId);

      allow create: if isOwner(userId) &&
                       isValidId(recordId) &&
                       isValidAttendanceRecord(incoming(), userId);

      // Action-based update: only webhook sync status and updatedAt can be updated; attendance facts remain tamper-proof
      allow update: if isOwner(userId) &&
                       isValidId(recordId) &&
                       isValidAttendanceRecord(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['syncedToSheets', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(recordId);
    }

    // --- User-Scoped Workplace & Employee Settings ---
    match /users/{userId}/settings/{settingId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && settingId == 'workplace';

      allow create: if isOwner(userId) &&
                       settingId == 'workplace' &&
                       isValidWorkplaceSettings(incoming(), userId);

      allow update: if isOwner(userId) &&
                       settingId == 'workplace' &&
                       isValidWorkplaceSettings(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'defaultEmployeeId',
                         'defaultEmployeeName',
                         'officeName',
                         'officeLatitude',
                         'officeLongitude',
                         'maxRadiusMeters',
                         'geofenceEnabled',
                         'sheetsWebhookUrl',
                         'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && settingId == 'workplace';
    }
  }
}
